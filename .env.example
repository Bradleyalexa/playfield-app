# ====================================================================
# Playfield (ClubCourt) Environment Configuration
# Salin file ini ke .env.local untuk local development
# Atau masukkan variabel ini ke Project Settings > Environment Variables di Vercel
# ====================================================================

# 1. Base URL Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Cloudflare R2 (S3-Compatible Object Storage)
# Digunakan untuk snapshot live session.json super cepat dengan biaya egress $0
# Dapatkan dari Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=playfield-sessions

# 3. Cloudflare D1 (Serverless SQLite Relational Database)
# Digunakan untuk data relasional, member clubs, dan history mabar
# Dapatkan dari Cloudflare Dashboard > Workers & Pages > D1
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_d1_edit_permission
